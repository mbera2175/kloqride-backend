# ─────────────────────────────────────────
#  Kloq Ride — Environment Variables
#  Copy this file to .env and fill values
# ─────────────────────────────────────────

# Database
# For development (SQLite - default, no setup needed)
DATABASE_URL=sqlite:///./kloqride.db

# For production (PostgreSQL - recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/kloqride

# JWT Security (change this to a long random string in production!)
SECRET_KEY=kloqride-secret-key-change-this-in-production

# App Settings
APP_NAME=Kloq Ride
APP_VERSION=1.0.0
DEBUG=True       # Set False in production

# SMS Provider - Fast2SMS (India)
# Get API key from https://fast2sms.com
FAST2SMS_API_KEY=your-fast2sms-api-key-here

# SMS Provider - Twilio (International)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE=+1XXXXXXXXXX

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
DEV_MODE=True    # Set False in production (hides OTP from API response)

# Admin Default Account (used by seed.py)
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=admin@kloq123
